# Copy to .env and adjust. The API reads these; Next reads MM_API_URL.

# Where downloaded media and the SQLite db live.
MM_LIBRARY_DIR=~/MediaManager/library

# SQLite file (defaults to <MM_LIBRARY_DIR>/.mm.db).
# MM_DB_PATH=~/MediaManager/library/.mm.db

# API bind address. Keep it on loopback unless you know why not.
MM_BIND=127.0.0.1:8787

# Allowed browser origin for CORS (the dev web server).
MM_WEB_ORIGIN=http://localhost:3000

# First-run admin. If unset, the web UI shows /setup instead.
# MM_ADMIN_EMAIL=you@example.com
# MM_ADMIN_PASSWORD=change-me-please

# Session lifetime, and set to 1 only behind TLS (Secure cookie).
MM_SESSION_DAYS=30
MM_COOKIE_SECURE=0

# Credentials used by `make e2e` (must be an existing account).
# MM_E2E_EMAIL=you@example.com
# MM_E2E_PASSWORD=change-me-please

# Download concurrency per host and backlog limit.
MM_MAX_CONCURRENT=8
MM_MAX_QUEUED=500
MM_MAX_DOWNLOAD_MB=2048

# Media files idle this many days are removed (metadata stays) and restored
# automatically on play. 0 disables eviction.
MM_EVICT_AFTER_DAYS=30
MM_EVICT_CHECK_HOURS=24

# Worker lease heartbeat (seconds). A crashed worker's job is re-queued after
# lease seconds without a heartbeat.
MM_HEARTBEAT_S=30
MM_LEASE_S=60

# combined | api | worker
MM_ROLE=combined

# External binaries.
# MM_YTDLP=yt-dlp
# MM_FFMPEG=ffmpeg

# Used by the web app's next.config rewrites.
MM_API_URL=http://127.0.0.1:8787
