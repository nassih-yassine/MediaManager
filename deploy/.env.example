# Copy to the deploy host as /opt/mediamanager/.env (chmod 600).
# IMAGE_PREFIX is set by you; IMAGE_TAG is provided by the deploy workflow.

IMAGE_PREFIX=ghcr.io/your-user/mediamanager
IMAGE_TAG=latest

# Public origin must match how you reach the app (Caddy/tunnel/reverse proxy).
MM_WEB_ORIGIN=https://media.example.com
MM_COOKIE_SECURE=1
PUBLIC_HOST=media.example.com

# First-run admin (only used while the users table is empty).
MM_ADMIN_EMAIL=you@example.com
MM_ADMIN_PASSWORD=change-this-now

MM_MAX_CONCURRENT=8
MM_MAX_QUEUED=500
MM_MAX_DOWNLOAD_MB=2048
MM_SESSION_DAYS=30
MM_EVICT_AFTER_DAYS=30
MM_EVICT_CHECK_HOURS=24
